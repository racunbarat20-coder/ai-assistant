# --- Secrets / keys (JANGAN commit .env, hanya .env.example) ---
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small

# --- Database relational ---
DATABASE_URL=sqlite:///./data/assistant.db

# --- Vector database ---
VECTOR_DATABASE_URL=qdrant://:memory:
QDRANT_PATH=./data/vector
QDRANT_COLLECTION=documents

# --- Security ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# PBKDF2 default (no external dep); set PASSWORD_PEPPER for extra entropy
PASSWORD_PEPPER=

# --- App ---
ENVIRONMENT=dev
LOG_LEVEL=INFO
# OPTIONAL: prompt for tools config / observability (OpenTelemetry etc.)
OTEL_EXPORTER_OTLP_ENDPOINT=